{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "nafa-plus-mcp",
      "version": "0.1.0",
      "title": "Nafa+ MCP"
    },
    "tools": [
      {
        "name": "list_products",
        "title": "List products",
        "description": "List Nafa+ inventory products, optionally filtered by stock status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter products by stock status.",
              "type": "string",
              "enum": [
                "ok",
                "low",
                "out"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_customer_debts",
        "title": "List customer debts",
        "description": "List outstanding customer credits (créances clients) tracked in Nafa+.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "minAmount": {
              "description": "Only return debts greater than or equal to this amount in FCFA.",
              "type": "number",
              "minimum": 0
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "sales_summary",
        "title": "Sales & stock summary",
        "description": "Return a snapshot of today's sales KPIs and low/out-of-stock alerts for Nafa+.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
